{
  // F5: build hexc (release), then a new VS Code window with the extension
  // loaded from editors/vscode/hexcavator, on the repository's test
  // binaries. The extension runs the hexc just built (target/release)
  // unless its path setting says otherwise.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hexcavator extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build hexc (release)",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode/hexcavator",
        "${workspaceFolder}/testdata"
      ]
    }
  ]
}
