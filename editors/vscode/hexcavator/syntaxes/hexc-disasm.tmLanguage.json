{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hexcavator Disassembly",
  "scopeName": "source.hexc-disasm",
  "patterns": [
    {
      "include": "#blocklabel"
    },
    {
      "include": "#title"
    },
    {
      "include": "#error"
    },
    {
      "include": "#instruction"
    }
  ],
  "repository": {
    "title": {
      "match": "^(\\S.*):$",
      "captures": {
        "1": {
          "name": "entity.name.function.hexc-disasm"
        }
      }
    },
    "error": {
      "match": "\\((?:not instructions)[^)]*\\).*$",
      "name": "invalid.illegal.hexc-disasm"
    },
    "instruction": {
      "begin": "^\\s+([0-9a-fA-F]+)\\s+(?:((?:>|L)?\\d+:)\\s*)?(?:([a-z][\\w.]*)\\b)?",
      "beginCaptures": {
        "1": {
          "name": "constant.numeric.address.hexc-disasm"
        },
        "2": {
          "name": "entity.name.label.hexc-disasm"
        },
        "3": {
          "name": "keyword.other.mnemonic.hexc-disasm"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#symbol"
        },
        {
          "include": "#label"
        },
        {
          "include": "#types"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keywords"
        }
      ]
    },
    "symbol": {
      "match": "<([^<>\\s][^<>]*)>",
      "captures": {
        "1": {
          "name": "entity.name.function.hexc-disasm"
        }
      }
    },
    "label": {
      "match": "(?<![\\w<])[<>]\\d+\\b|\\bL\\d+\\b",
      "name": "entity.name.label.hexc-disasm"
    },
    "types": {
      "match": "\\b(?:i32|i64|f32|f64|v128|funcref|externref|anyref|eqref|i31ref|structref|arrayref|exnref|nullref|nullfuncref|nullexternref|nullexnref|ref|null|local|result|type|catch|catch_ref|catch_all|catch_all_ref|i32x4)\\b",
      "name": "storage.type.hexc-disasm"
    },
    "number": {
      "match": "#?-?(?:0x[0-9a-fA-F]+|\\d+(?:\\.\\d+)?(?:e[+-]?\\d+)?|inf|nan(?::0x[0-9a-fA-F]+)?)\\b",
      "name": "constant.numeric.hexc-disasm"
    },
    "keywords": {
      "match": "\\b(?:offset|align)=",
      "name": "variable.parameter.hexc-disasm"
    },
    "blocklabel": {
      "match": "^(L\\d+):$",
      "captures": {
        "1": {
          "name": "entity.name.label.hexc-disasm"
        }
      }
    }
  }
}
